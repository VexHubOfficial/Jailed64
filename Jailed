local Visuals = {}

local function RemoveVisual(player)
	local data = Visuals[player]

	if not data then
		return
	end

	if data.Highlight then
		data.Highlight:Destroy()
	end

	if data.HP then
		data.HP:Destroy()
	end

	if data.HealthConnection then
		data.HealthConnection:Disconnect()
	end

	Visuals[player] = nil
end

local function CreateHP(player, character, humanoid)
	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not root then
		return nil, nil
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "VexHP"
	gui.Adornee = root
	gui.Size = UDim2.fromOffset(8, 65)
	gui.StudsOffset = Vector3.new(-2.5, 0, 0)
	gui.AlwaysOnTop = true
	gui.Parent = root

	local background = Instance.new("Frame")
	background.Size = UDim2.fromScale(1, 1)
	background.BackgroundColor3 =
		Color3.fromRGB(25, 20, 30)
	background.BorderSizePixel = 0
	background.Parent = gui

	local bgCorner = Instance.new("UICorner")
	bgCorner.CornerRadius = UDim.new(1, 0)
	bgCorner.Parent = background

	local fill = Instance.new("Frame")
	fill.AnchorPoint = Vector2.new(0, 1)
	fill.Position = UDim2.fromScale(0, 1)
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 =
		Color3.fromRGB(170, 70, 255)
	fill.BorderSizePixel = 0
	fill.Parent = background

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	local function update()
		local maxHealth =
			math.max(humanoid.MaxHealth, 1)

		local percent =
			math.clamp(
				humanoid.Health / maxHealth,
				0,
				1
			)

		fill.Size =
			UDim2.new(1, 0, percent, 0)
	end

	update()

	local connection =
		humanoid.HealthChanged:Connect(update)

	return gui, connection
end

local function ShouldHighlight(player)
	if player == LocalPlayer then
		return false
	end

	if not player.Character then
		return false
	end

	if Settings.AllHighlight then
		return true
	end

	if Settings.TeamHighlight then
		return
			LocalPlayer.Team ~= nil
			and player.Team ~= nil
			and player.Team == LocalPlayer.Team
	end

	return false
end

local VisualFolder = Instance.new("Folder")
VisualFolder.Name = "VexHubVisuals"
VisualFolder.Parent = Gui

local function UpdatePlayerVisual(player)
	if player == LocalPlayer then
		return
	end

	local character = player.Character

	if not character or not character.Parent then
		RemoveVisual(player)
		return
	end

	if not ShouldHighlight(player) then
		RemoveVisual(player)
		return
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	local existing = Visuals[player]

	if existing and existing.Character ~= character then
		RemoveVisual(player)
		existing = nil
	end

	if not existing then
		local highlight = Instance.new("Highlight")

		highlight.Name = "VexHighlight"
		highlight.Adornee = character
		highlight.FillColor =
			Color3.fromRGB(155, 55, 255)
		highlight.OutlineColor =
			Color3.fromRGB(220, 170, 255)
		highlight.FillTransparency = 0.5
		highlight.OutlineTransparency = 0
		highlight.DepthMode =
			Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = VisualFolder

		local hp
		local healthConnection

		if Settings.HPBar then
			hp, healthConnection =
				CreateHP(
					player,
					character,
					humanoid
				)
		end

		Visuals[player] = {
			Character = character,
			Highlight = highlight,
			HP = hp,
			HealthConnection = healthConnection,
		}

		return
	end

	if Settings.HPBar and not existing.HP then
		existing.HP,
		existing.HealthConnection =
			CreateHP(
				player,
				character,
				humanoid
			)

	elseif not Settings.HPBar and existing.HP then
		existing.HP:Destroy()
		existing.HP = nil

		if existing.HealthConnection then
			existing.HealthConnection:Disconnect()
			existing.HealthConnection = nil
		end
	end
end

--==================================================
-- PLAYER TRACKING
--==================================================

local function SetupPlayer(player)
	if player == LocalPlayer then
		return
	end

	player.CharacterAdded:Connect(function(character)
		RemoveVisual(player)

		task.spawn(function()
			character:WaitForChild("Humanoid", 5)
			character:WaitForChild("HumanoidRootPart", 5)

			task.wait()

			UpdatePlayerVisual(player)
		end)
	end)

	player.CharacterRemoving:Connect(function()
		RemoveVisual(player)
	end)

	player:GetPropertyChangedSignal("Team"):Connect(function()
		UpdatePlayerVisual(player)
	end)

	if player.Character then
		UpdatePlayerVisual(player)
	end
end

for _, player in ipairs(Players:GetPlayers()) do
	SetupPlayer(player)
end

Players.PlayerAdded:Connect(SetupPlayer)

Players.PlayerRemoving:Connect(function(player)
	RemoveVisual(player)
end)

-- Refresh visuals without RenderStepped
task.spawn(function()
	while Gui.Parent do
		if Settings.AllHighlight or Settings.TeamHighlight then
			for _, player in ipairs(Players:GetPlayers()) do
				UpdatePlayerVisual(player)
			end
		end

		task.wait(0.3)
	end
end)


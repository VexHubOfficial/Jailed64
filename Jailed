local function CreateButton(Parent, Text)
	local Button = Instance.new("TextButton")

	Button.Size = UDim2.new(1, 0, 0, 36)
	Button.BackgroundColor3 = Color3.fromRGB(32, 21, 42)
	Button.BorderSizePixel = 0
	Button.Text = Text
	Button.TextColor3 = Color3.fromRGB(235, 225, 245)
	Button.TextSize = 14
	Button.Font = Enum.Font.GothamMedium
	Button.AutoButtonColor = false
	Button.LayoutOrder = 10
	Button.Parent = Parent

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 8)
	Corner.Parent = Button

	local Stroke = Instance.new("UIStroke")
	Stroke.Color = Color3.fromRGB(65, 38, 85)
	Stroke.Thickness = 1
	Stroke.Parent = Button

	Button.MouseEnter:Connect(function()
		Button.BackgroundColor3 = Color3.fromRGB(43, 27, 57)
	end)

	Button.MouseLeave:Connect(function()
		if Button:GetAttribute("Enabled") then
			Button.BackgroundColor3 = Color3.fromRGB(75, 35, 110)
		else
			Button.BackgroundColor3 = Color3.fromRGB(32, 21, 42)
		end
	end)

	return Button
end

local function SetToggle(Button, Name, State)
	Button:SetAttribute("Enabled", State)

	Button.Text =
		Name .. "     [ " ..
		(State and "ON" or "OFF") ..
		" ]"

	Button.BackgroundColor3 =
		State
		and Color3.fromRGB(75, 35, 110)
		or Color3.fromRGB(32, 21, 42)
end


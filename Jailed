local function SetButtonState(button, label, enabled)
	button.Text = label .. "     [ " .. (enabled and "ON" or "OFF") .. " ]"

	button.BackgroundColor3 = enabled
		and Color3.fromRGB(75, 35, 110)
		or Color3.fromRGB(32, 21, 42)
end


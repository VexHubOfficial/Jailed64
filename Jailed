--==================================================
-- VISUALS
--==================================================

local VisualFolder = Instance.new("Folder")
VisualFolder.Name = "VexHubVisuals"
VisualFolder.Parent = ScreenGui

local Visuals = {}

local function RemoveVisual(player)
	local data = Visuals[player]

	if not data then
		return
	end

	if data.Highlight then
		data.Highlight:Destroy()
	end

	if data.HP then
		data.HP:Destroy()
	end

	if data.HealthConnection then
		data.HealthConnection:Disconnect()
	end

	Visuals[player] = nil
end

local function HighlightAllowed(player)
	if player == LocalPlayer then
		return false
	end

	if not player.Character then
		return false
	end

	if not player.Character.Parent then
		return false
	end

	if Settings.AllHighlight then
		return true
	end

	if Settings.TeamHighlight then
		return player.Team ~= nil
			and LocalPlayer.Team ~= nil
			and player.Team == LocalPlayer.Team
	end

	return false
end

local function MakeHP(player, character, humanoid)
	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not root then
		return nil, nil
	end

	local Billboard = Instance.new("BillboardGui")

	Billboard.Name = "VexHP"
	Billboard.Adornee = root
	Billboard.Size = UDim2.fromOffset(8, 70)
	Billboard.StudsOffset =
		Vector3.new(-2.5, 0, 0)
	Billboard.AlwaysOnTop = true
	Billboard.Parent = root

	local Background = Instance.new("Frame")

	Background.Size = UDim2.fromScale(1, 1)
	Background.BackgroundColor3 =
		Color3.fromRGB(25, 20, 30)
	Background.BorderSizePixel = 0
	Background.Parent = Billboard

	local BGCorner = Instance.new("UICorner")
	BGCorner.CornerRadius = UDim.new(1, 0)
	BGCorner.Parent = Background

	local Fill = Instance.new("Frame")

	Fill.AnchorPoint =
		Vector2.new(0, 1)

	Fill.Position =
		UDim2.fromScale(0, 1)

	Fill.Size =
		UDim2.fromScale(1, 1)

	Fill.BackgroundColor3 =
		Color3.fromRGB(170, 70, 255)

	Fill.BorderSizePixel = 0
	Fill.Parent = Background

	local FillCorner = Instance.new("UICorner")
	FillCorner.CornerRadius = UDim.new(1, 0)
	FillCorner.Parent = Fill

	local function Update()
		local maxHealth =
			math.max(humanoid.MaxHealth, 1)

		local percent =
			math.clamp(
				humanoid.Health / maxHealth,
				0,
				1
			)

		Fill.Size =
			UDim2.new(
				1,
				0,
				percent,
				0
			)
	end

	Update()

	local Connection =
		humanoid.HealthChanged:Connect(Update)

	return Billboard, Connection
end

local function CreateVisual(player)
	if player == LocalPlayer then
		return
	end

	local character = player.Character

	if not character or not character.Parent then
		RemoveVisual(player)
		return
	end

	if not HighlightAllowed(player) then
		RemoveVisual(player)
		return
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	local Existing = Visuals[player]

	if Existing
		and Existing.Character ~= character then

		RemoveVisual(player)
		Existing = nil
	end

	if not Existing then

		local Highlight = Instance.new("Highlight")

		Highlight.Name = "VexHighlight"
		Highlight.Adornee = character

		-- Vex purple
		Highlight.FillColor =
			Color3.fromRGB(155, 55, 255)

		Highlight.OutlineColor =
			Color3.fromRGB(220, 170, 255)

		Highlight.FillTransparency = 0.5
		Highlight.OutlineTransparency = 0
		Highlight.DepthMode =
			Enum.HighlightDepthMode.AlwaysOnTop

		Highlight.Parent = VisualFolder

		local HP
		local HealthConnection

		if Settings.HPBar then
			HP, HealthConnection =
				MakeHP(
					player,
					character,
					humanoid
				)
		end

		Visuals[player] = {
			Character = character,
			Highlight = Highlight,
			HP = HP,
			HealthConnection = HealthConnection,
		}

		return
	end

	-- HP BAR ON
	if Settings.HPBar and not Existing.HP then

		Existing.HP,
		Existing.HealthConnection =
			MakeHP(
				player,
				character,
				humanoid
			)

	-- HP BAR OFF
	elseif not Settings.HPBar and Existing.HP then

		Existing.HP:Destroy()
		Existing.HP = nil

		if Existing.HealthConnection then
			Existing.HealthConnection:Disconnect()
			Existing.HealthConnection = nil
		end
	end
end

--==================================================
-- PLAYER TRACKING
--==================================================

local function SetupPlayer(player)
	if player == LocalPlayer then
		return
	end

	player.CharacterAdded:Connect(function(character)

		RemoveVisual(player)

		task.spawn(function()

			character:WaitForChild(
				"Humanoid",
				5
			)

			character:WaitForChild(
				"HumanoidRootPart",
				5
			)

			task.wait()

			CreateVisual(player)
		end)
	end)

	player.CharacterRemoving:Connect(function()
		RemoveVisual(player)
	end)

	player:GetPropertyChangedSignal(
		"Team"
	):Connect(function()

		CreateVisual(player)
	end)

	if player.Character then
		CreateVisual(player)
	end
end

for _, player in ipairs(
	Players:GetPlayers()
) do
	SetupPlayer(player)
end

Players.PlayerAdded:Connect(SetupPlayer)

Players.PlayerRemoving:Connect(function(player)
	RemoveVisual(player)
end)

--==================================================
-- VISUAL REFRESH
--==================================================

task.spawn(function()

	while ScreenGui.Parent do

		for _, player in ipairs(
			Players:GetPlayers()
		) do

			if player ~= LocalPlayer then
				CreateVisual(player)
			end
		end

		task.wait(0.25)
	end
end)

--==================================================
-- NOCLIP
--==================================================

local function ApplyNoclip()

	if not Settings.Noclip then
		return
	end

	local character =
		LocalPlayer.Character

	if not character then
		return
	end

	for _, object in ipairs(
		character:GetDescendants()
	) do

		if object:IsA("BasePart") then
			object.CanCollide = false
		end
	end
end

RunService.Stepped:Connect(function()

	if Settings.Noclip then
		ApplyNoclip()
	end
end)

--==================================================
-- WALKSPEED
--==================================================

local function ApplySpeed()

	local character =
		LocalPlayer.Character

	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if humanoid then
		humanoid.WalkSpeed =
			Settings.WalkSpeed
	end
end

RunService.Heartbeat:Connect(ApplySpeed)

--==================================================
-- INFINITE JUMP
--==================================================

UserInputService.JumpRequest:Connect(function()

	if not Settings.InfiniteJump then
		return
	end

	local character =
		LocalPlayer.Character

	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if humanoid then
		humanoid:ChangeState(
			Enum.HumanoidStateType.Jumping
		)
	end
end)


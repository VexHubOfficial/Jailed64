local VisualFolder = Instance.new("Folder")
VisualFolder.Name = "VexHubVisuals"
VisualFolder.Parent = ScreenGui

local Visuals = {}

--==================================================
-- REMOVE VISUAL
--==================================================

local function RemoveVisual(Player)
	local Data = Visuals[Player]

	if not Data then
		return
	end

	if Data.Highlight then
		Data.Highlight:Destroy()
	end

	if Data.HP then
		Data.HP:Destroy()
	end

	if Data.HealthConnection then
		Data.HealthConnection:Disconnect()
	end

	Visuals[Player] = nil
end

--==================================================
-- HIGHLIGHT CHECK
--==================================================

local function ShouldHighlight(Player)
	if Player == LocalPlayer then
		return false
	end

	local Character = Player.Character

	if not Character or not Character.Parent then
		return false
	end

	if Settings.AllHighlight then
		return true
	end

	if Settings.TeamHighlight then
		return Player.Team ~= nil
			and LocalPlayer.Team ~= nil
			and Player.Team == LocalPlayer.Team
	end

	return false
end

--==================================================
-- HP BAR
--==================================================

local function CreateHPBar(Player, Character, Humanoid)
	local Root =
		Character:FindFirstChild("HumanoidRootPart")

	if not Root then
		return nil, nil
	end

	local Billboard = Instance.new("BillboardGui")
	Billboard.Name = "VexHP"
	Billboard.Adornee = Root
	Billboard.Size = UDim2.fromOffset(8, 70)
	Billboard.StudsOffset = Vector3.new(-2.5, 0, 0)
	Billboard.AlwaysOnTop = true
	Billboard.Parent = Root

	local Background = Instance.new("Frame")
	Background.Size = UDim2.fromScale(1, 1)
	Background.BackgroundColor3 = Color3.fromRGB(25, 20, 30)
	Background.BorderSizePixel = 0
	Background.Parent = Billboard

	local BGCorner = Instance.new("UICorner")
	BGCorner.CornerRadius = UDim.new(1, 0)
	BGCorner.Parent = Background

	local Fill = Instance.new("Frame")
	Fill.AnchorPoint = Vector2.new(0, 1)
	Fill.Position = UDim2.fromScale(0, 1)
	Fill.Size = UDim2.fromScale(1, 1)
	Fill.BackgroundColor3 = Color3.fromRGB(170, 70, 255)
	Fill.BorderSizePixel = 0
	Fill.Parent = Background

	local FillCorner = Instance.new("UICorner")
	FillCorner.CornerRadius = UDim.new(1, 0)
	FillCorner.Parent = Fill

	local function UpdateHealth()
		local MaxHealth =
			math.max(Humanoid.MaxHealth, 1)

		local Percent =
			math.clamp(
				Humanoid.Health / MaxHealth,
				0,
				1
			)

		Fill.Size =
			UDim2.new(
				1,
				0,
				Percent,
				0
			)
	end

	UpdateHealth()

	local Connection =
		Humanoid.HealthChanged:Connect(UpdateHealth)

	return Billboard, Connection
end

--==================================================
-- CREATE VISUAL
--==================================================

local function CreateVisual(Player)
	if Player == LocalPlayer then
		return
	end

	local Character = Player.Character

	if not Character or not Character.Parent then
		RemoveVisual(Player)
		return
	end

	if not ShouldHighlight(Player) then
		RemoveVisual(Player)
		return
	end

	local Humanoid =
		Character:FindFirstChildOfClass("Humanoid")

	if not Humanoid then
		return
	end

	local Existing = Visuals[Player]

	if Existing
		and Existing.Character ~= Character then

		RemoveVisual(Player)
		Existing = nil
	end

	if not Existing then

		local Highlight = Instance.new("Highlight")

		Highlight.Name = "VexHighlight"
		Highlight.Adornee = Character

		Highlight.FillColor =
			Color3.fromRGB(155, 55, 255)

		Highlight.OutlineColor =
			Color3.fromRGB(220, 170, 255)

		Highlight.FillTransparency = 0.5
		Highlight.OutlineTransparency = 0

		Highlight.DepthMode =
			Enum.HighlightDepthMode.AlwaysOnTop

		Highlight.Parent = VisualFolder

		local HP
		local HealthConnection

		if Settings.HPBar then
			HP, HealthConnection =
				CreateHPBar(
					Player,
					Character,
					Humanoid
				)
		end

		Visuals[Player] = {
			Character = Character,
			Highlight = Highlight,
			HP = HP,
			HealthConnection = HealthConnection,
		}

		return
	end

	if Settings.HPBar and not Existing.HP then

		Existing.HP,
		Existing.HealthConnection =
			CreateHPBar(
				Player,
				Character,
				Humanoid
			)

	elseif not Settings.HPBar and Existing.HP then

		Existing.HP:Destroy()
		Existing.HP = nil

		if Existing.HealthConnection then
			Existing.HealthConnection:Disconnect()
			Existing.HealthConnection = nil
		end
	end
end

--==================================================
-- PLAYER TRACKING
--==================================================

local function SetupPlayer(Player)
	if Player == LocalPlayer then
		return
	end

	Player.CharacterAdded:Connect(function(Character)

		RemoveVisual(Player)

		task.spawn(function()

			Character:WaitForChild(
				"Humanoid",
				5
			)

			Character:WaitForChild(
				"HumanoidRootPart",
				5
			)

			task.wait()

			CreateVisual(Player)
		end)
	end)

	Player.CharacterRemoving:Connect(function()
		RemoveVisual(Player)
	end)

	Player:GetPropertyChangedSignal(
		"Team"
	):Connect(function()
		CreateVisual(Player)
	end)

	if Player.Character then
		CreateVisual(Player)
	end
end

for _, Player in ipairs(
	Players:GetPlayers()
) do
	SetupPlayer(Player)
end

Players.PlayerAdded:Connect(SetupPlayer)

Players.PlayerRemoving:Connect(function(Player)
	RemoveVisual(Player)
end)

task.spawn(function()

	while ScreenGui.Parent do

		for _, Player in ipairs(
			Players:GetPlayers()
		) do

			if Player ~= LocalPlayer then
				CreateVisual(Player)
			end
		end

		task.wait(0.25)
	end
end)


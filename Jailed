local Hidden = {}

local function HideCharacter(character)
	for _, object in ipairs(character:GetDescendants()) do

		if object:IsA("BasePart") then
			if object.Name ~= "HumanoidRootPart" then

				if Hidden[object] == nil then
					Hidden[object] =
						object.LocalTransparencyModifier
				end

				object.LocalTransparencyModifier = 1
			end

		elseif object:IsA("Decal")
			or object:IsA("Texture") then

			if Hidden[object] == nil then
				Hidden[object] = object.Transparency
			end

			object.Transparency = 1
		end
	end
end

local function RestoreCharacter()
	for object, value in pairs(Hidden) do
		if object and object.Parent then
			if object:IsA("BasePart") then
				object.LocalTransparencyModifier = value
			elseif object:IsA("Decal")
				or object:IsA("Texture") then
				object.Transparency = value
			end
		end
	end

	table.clear(Hidden)
end

InvisButton.MouseButton1Click:Connect(function()
	Settings.Invisibility =
		not Settings.Invisibility

	ToggleText(
		InvisButton,
		"Invisibility",
		Settings.Invisibility
	)

	local character = LocalPlayer.Character

	if not character then
		return
	end

	if Settings.Invisibility then
		HideCharacter(character)
	else
		RestoreCharacter()
	end
end)


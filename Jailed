	SetToggle(
		InvisibilityButton,
		"Invisibility",
		Settings.Invisibility
	)

	if not Settings.Invisibility then
		RestoreBody()
	end
end)

RunService.Stepped:Connect(function()

	if Settings.Invisibility then
		HideBody()
	end
end)


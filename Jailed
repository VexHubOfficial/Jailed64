local frameCount = 0
local fpsTimer = os.clock()

RunService.RenderStepped:Connect(function()
	frameCount += 1

	local now = os.clock()

	if now - fpsTimer >= 1 then
		local fps = math.floor(
			frameCount / (now - fpsTimer) + 0.5
		)

		local ping = math.floor(
			LocalPlayer:GetNetworkPing() * 1000 + 0.5
		)

		StatsLabel.Text =
			"FPS: " .. fps .. " | MS: " .. ping

		frameCount = 0
		fpsTimer = now
	end
end)


local function SetToggle(Button, Name, Enabled)
	Button.Text =
		Name .. "     [ " ..
		(Enabled and "ON" or "OFF") ..
		" ]"

	if Enabled then
		Button.BackgroundColor3 =
			Color3.fromRGB(75, 35, 110)
	else
		Button.BackgroundColor3 =
			Color3.fromRGB(32, 21, 42)
	end
end


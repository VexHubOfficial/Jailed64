local HighlightFolder = Instance.new("Folder")
HighlightFolder.Name = "VexHubVisuals"
HighlightFolder.Parent = ScreenGui

local PlayerVisuals = {}

local function RemovePlayerVisual(player)
	local data = PlayerVisuals[player]

	if not data then
		return
	end

	if data.highlight then
		data.highlight:Destroy()
	end

	if data.hpGui then
		data.hpGui:Destroy()
	end

	if data.healthConnection then
		data.healthConnection:Disconnect()
	end

	PlayerVisuals[player] = nil
end

local function IsHighlightEnabledFor(player)
	if not player.Character or not player.Character.Parent then
		return false
	end

	if Settings.AllHighlight then
		return true
	end

	if Settings.TeamHighlight then
		return player.Team ~= nil
			and LocalPlayer.Team ~= nil
			and player.Team == LocalPlayer.Team
	end

	return false
end

local function CreateHPBar(player, character, humanoid)
	local root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		return nil, nil
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "VexHPBar"
	gui.Adornee = root
	gui.Size = UDim2.fromOffset(8, 70)
	gui.StudsOffset = Vector3.new(-2.4, 0, 0)
	gui.AlwaysOnTop = true
	gui.Parent = root

	local background = Instance.new("Frame")
	background.Size = UDim2.fromScale(1, 1)
	background.BackgroundColor3 = Color3.fromRGB(25, 20, 30)
	background.BorderSizePixel = 0
	background.Parent = gui

	local bgCorner = Instance.new("UICorner")
	bgCorner.CornerRadius = UDim.new(1, 0)
	bgCorner.Parent = background

	local fill = Instance.new("Frame")
	fill.AnchorPoint = Vector2.new(0, 1)
	fill.Position = UDim2.fromScale(0, 1)
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(170, 70, 255)
	fill.BorderSizePixel = 0
	fill.Parent = background

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	local function UpdateHealth()
		local maxHealth = math.max(humanoid.MaxHealth, 1)
		local percent = math.clamp(humanoid.Health / maxHealth, 0, 1)

		fill.Size = UDim2.new(1, 0, percent, 0)
	end

	UpdateHealth()

	return gui, humanoid.HealthChanged:Connect(UpdateHealth)
end

local function CreatePlayerVisual(player)
	if player == LocalPlayer then
		return
	end

	local character = player.Character

	if not character or not character.Parent then
		RemovePlayerVisual(player)
		return
	end

	if not IsHighlightEnabledFor(player) then
		RemovePlayerVisual(player)
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	local current = PlayerVisuals[player]

	-- Rebuild if the character changed.
	if current and current.character ~= character then
		RemovePlayerVisual(player)
		current = nil
	end

	if not current then
		local highlight = Instance.new("Highlight")
		highlight.Name = "VexHighlight"
		highlight.Adornee = character
		highlight.FillColor = Color3.fromRGB(155, 55, 255)
		highlight.OutlineColor = Color3.fromRGB(220, 170, 255)
		highlight.FillTransparency = 0.5
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = HighlightFolder

		local hpGui
		local healthConnection

		if Settings.HPBar then
			hpGui, healthConnection =
				CreateHPBar(player, character, humanoid)
		end

		PlayerVisuals[player] = {
			character = character,
			highlight = highlight,
			hpGui = hpGui,
			healthConnection = healthConnection,
		}

		return
	end

	-- HP bar state changed.
	if Settings.HPBar and not current.hpGui then
		current.hpGui, current.healthConnection =
			CreateHPBar(player, character, humanoid)
	elseif not Settings.HPBar and current.hpGui then
		current.hpGui:Destroy()
		current.hpGui = nil

		if current.healthConnection then
			current.healthConnection:Disconnect()
			current.healthConnection = nil
		end
	end
end

local function SetupPlayer(player)
	if player == LocalPlayer then
		return
	end

	player.CharacterAdded:Connect(function(character)
		RemovePlayerVisual(player)

		task.spawn(function()
			character:WaitForChild("Humanoid", 5)
			character:WaitForChild("HumanoidRootPart", 5)

			task.wait()

			CreatePlayerVisual(player)
		end)
	end)

	player.CharacterRemoving:Connect(function()
		RemovePlayerVisual(player)
	end)

	player:GetPropertyChangedSignal("Team"):Connect(function()
		CreatePlayerVisual(player)
	end)

	if player.Character then
		CreatePlayerVisual(player)
	end
end

for _, player in ipairs(Players:GetPlayers()) do
	SetupPlayer(player)
end

Players.PlayerAdded:Connect(SetupPlayer)

Players.PlayerRemoving:Connect(function(player)
	RemovePlayerVisual(player)
end)

-- Refresh visuals whenever settings change.
task.spawn(function()
	while ScreenGui.Parent do
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				CreatePlayerVisual(player)
			end
		end

		task.wait(0.25)
	end
end)


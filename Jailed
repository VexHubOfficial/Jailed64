local function Section(text)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -8, 0, 25)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(190, 120, 255)
	label.TextSize = 15
	label.Font = Enum.Font.GothamBold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = Scroll
	return label
end

local function Button(text)
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, -8, 0, 34)
	button.BackgroundColor3 = Color3.fromRGB(32, 21, 42)
	button.TextColor3 = Color3.fromRGB(235, 225, 245)
	button.TextSize = 14
	button.Font = Enum.Font.GothamMedium
	button.Text = text
	button.AutoButtonColor = false
	button.Parent = Scroll

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = button

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(65, 38, 85)
	stroke.Thickness = 1
	stroke.Parent = button

	return button
end

local function SetToggle(button, name, state)
	button.Text = name .. "     [ " .. (state and "ON" or "OFF") .. " ]"
	button.BackgroundColor3 = state
		and Color3.fromRGB(75, 35, 110)
		or Color3.fromRGB(32, 21, 42)
end


local function Toggle(text, callback)
	local B = Button(text .. "     [ OFF ]")
	local enabled = false

	B.MouseButton1Click:Connect(function()
		enabled = not enabled
		B.Text = text .. (enabled and "     [ ON ]" or "     [ OFF ]")
		B.BackgroundColor3 = enabled
			and Color3.fromRGB(75, 35, 110)
			or Color3.fromRGB(32, 21, 42)

		callback(enabled)
	end)

	return B
end

local function ValueButton(text, value, callback)
	local B = Button(text .. ": " .. tostring(value))

	B.MouseButton1Click:Connect(function()
		value = callback(value)
		B.Text = text .. ": " .. tostring(value)
	end)

	return B
end


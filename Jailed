--==================================================
-- INVISIBILITY
--==================================================

local InvisibleParts = {}
local INVISIBILITY_OFFSET = Vector3.new(0, -100, 0)

local function RestoreInvisibility()
	for Part, OriginalCFrame in pairs(InvisibleParts) do

		if Part and Part.Parent then
			Part.CFrame = OriginalCFrame
		end
	end

	table.clear(InvisibleParts)
end

local function HideBody()

	local Character =
		LocalPlayer.Character

	if not Character then
		return
	end

	for _, Object in ipairs(
		Character:GetDescendants()
	) do

		if Object:IsA("BasePart")
			and Object.Name ~= "HumanoidRootPart" then

			if not InvisibleParts[Object] then
				InvisibleParts[Object] =
					Object.CFrame
			end

			Object.CFrame =
				InvisibleParts[Object]
				+ INVISIBILITY_OFFSET
		end
	end
end

InvisibilityButton.MouseButton1Click:Connect(function()

	Settings.Invisibility =
		not Settings.Invisibility

	SetToggle(
		InvisibilityButton,
		"Invisibility",
		Settings.Invisibility
	)

	if not Settings.Invisibility then
		RestoreInvisibility()
	end
end)

RunService.Stepped:Connect(function()

	if Settings.Invisibility then
		HideBody()
	end
end)

